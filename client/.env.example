# Copy to .env.local for local development with `vercel dev` (or run `vercel env pull .env.local`).
# Never commit real values. Set the same names in Vercel → Project → Settings → Environment Variables:
# TEST-mode keys for Preview/Development, LIVE keys only for Production.

# Server-only (used by client/api/*). Do NOT add a REACT_APP_ prefix: that would publish them in the website's JavaScript.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Optional: largest single online donation in rupees (default 500000).
DONATION_MAX_INR=500000
